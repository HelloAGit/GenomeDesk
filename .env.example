# --- Dev API-key compatibility mode (single shared key -> default project) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=your_generated_api_key_here
# Set false to disable the shared-key mode entirely (multi-user deployments)
LEGACY_API_KEY_ENABLED=true

# --- Identity-based auth (multi-user). Enabled when AUTH_SECRET_KEY has >= 32 chars ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_MINUTES=60
# Keep false in production; create users with: python -m app.auth.cli EMAIL NAME
REGISTRATION_OPEN=false

# --- Database ---
# Empty => SQLite at DATA_DIR/genomedesk_v2.sqlite3. PostgreSQL example (run `alembic upgrade head`):
# DATABASE_URL=postgresql+psycopg://genomedesk:<password>@localhost:5432/genomedesk
DATABASE_URL=
DATA_DIR=./data

# --- Upload limits ---
MAX_UPLOAD_BYTES=10485760
MAX_DECOMPRESSED_BYTES=104857600
MAX_RECORDS=50000

# --- Rate limits (requests/minute per client address; 0 disables) ---
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Retention (days; 0 keeps data until deleted). Run: python -m app.services.retention ---
SAMPLE_RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=0

# --- Nebius Token Factory (optional; backend-only, never expose to the browser) ---
# Create account at https://tokenfactory.nebius.com
NEBIUS_API_KEY=your_token_factory_api_key_here
# Exact model ID from your Nebius account
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Variant-level data is NEVER sent to the AI provider unless you explicitly approve it here.
AI_SHARE_VARIANT_LEVEL=false

# CORS origins for frontend integration (scheme and port; JSON list)
CORS_ORIGINS=["http://localhost:3000"]
