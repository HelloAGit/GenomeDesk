# Backend API Key
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=your_generated_api_key_here

# Nebius Token Factory credentials (required only for /explain endpoint)
# Create account at https://tokenfactory.nebius.com
# Get your key from the Token Factory console
NEBIUS_API_KEY=your_token_factory_api_key_here

# Exact model ID from your Nebius account
# List available models: curl -s 'https://api.tokenfactory.nebius.com/v1/models?verbose=false' \
#   -H "Authorization: Bearer $NEBIUS_API_KEY" -H 'accept: application/json'
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# CORS origins for frontend integration
# Include scheme and port. Multiple origins separated by comma.
CORS_ORIGINS=http://localhost:3000
