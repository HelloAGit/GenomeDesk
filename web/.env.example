# Server-only: never prefix these with NEXT_PUBLIC_.
GENOMEDESK_API_URL=http://127.0.0.1:8000
# To connect to the deployed Render backend instead:
# GENOMEDESK_API_URL=https://genomedesk.onrender.com
# Match BACKEND_API_KEY on the backend you are connecting to.
# For Render, use the value stored in the backend service's Environment settings.
# Enter it securely here or in the frontend's hosting environment; never commit it.
GENOMEDESK_BACKEND_KEY=
# Proxy multipart body limit (includes overhead). Backend enforces its own file limit.
GENOMEDESK_MAX_BODY_BYTES=12582912
# Nebius credentials belong ONLY in the Python backend's environment.

# Public hosting: HTTPS frontend origin. Render supplies RENDER_EXTERNAL_URL
# automatically; GENOMEDESK_SITE_URL overrides it for a custom domain.
# GENOMEDESK_SITE_URL=https://your-frontend.onrender.com
# Required for public hosting. Shared demo login, NOT the backend key.
# GENOMEDESK_DEMO_USER=researcher
# GENOMEDESK_DEMO_PASSWORD=
# Use a random password of at least 16 characters; keep it server-side.
